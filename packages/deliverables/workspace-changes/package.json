{
  "name": "@mutantcat/dsh-workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons, for the DeepSeek Harness",
  "version": "1.0.20260923",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@mutantcat/schemastery": "workspace:^",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:^",
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-subprocess": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@mutantcat/cordis": "workspace:^",
    "@mutantcat/cordis-plugin-include": "workspace:^",
    "@mutantcat/cordis-plugin-loader": "workspace:^",
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-subprocess": "workspace:^",
    "@mutantcat/dsh-subprocess-local": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^"
  }
}
