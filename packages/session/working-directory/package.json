{
  "name": "@mutantcat/dsh-working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:~",
    "@mutantcat/dsh-agent": "workspace:*",
    "@mutantcat/dsh-fs": "workspace:*",
    "@mutantcat/dsh-llm": "workspace:*",
    "@mutantcat/dsh-session": "workspace:*",
    "@mutantcat/dsh-session-projection": "workspace:*",
    "@mutantcat/dsh-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@mutantcat/dsh-sandbox-policy": "workspace:*",
    "@mutantcat/dsh-user-approval": "workspace:*",
    "@mutantcat/cordis": "workspace:~",
    "@mutantcat/dsh-agent": "workspace:*",
    "@mutantcat/dsh-fs": "workspace:*",
    "@mutantcat/dsh-llm": "workspace:*",
    "@mutantcat/dsh-session": "workspace:*",
    "@mutantcat/dsh-session-projection": "workspace:*",
    "@mutantcat/dsh-system-prompt": "workspace:*",
    "@mutantcat/dsh-agent-loop-testkit": "workspace:*",
    "@mutantcat/dsh-fs-local": "workspace:*",
    "@mutantcat/dsh-tool-working-directory": "workspace:*",
    "@mutantcat/dsh-tools": "workspace:*"
  },
  "dependencies": {
    "@mutantcat/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
