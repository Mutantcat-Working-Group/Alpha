{
  "name": "@mutantcat/dsh-app-boot",
  "description": "Shared boot glue for the app bins: .env loading, fail-loud Loader guards, snapshot-aware config resolution, and the Loader boot sequence",
  "version": "1.0.20260923",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/app-boot"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker/profile-resolution-bootstrap": {
      "types": "./lib/types/profile-resolution/worker-bootstrap.d.ts",
      "default": "./lib/worker/profile-resolution-bootstrap.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker/profile-resolution-bootstrap.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@mutantcat/dsh-atomic-write": "workspace:^",
    "@mutantcat/dsh-package-manifest": "workspace:^",
    "js-yaml": "^4.2.0",
    "node-addon-require-builtin": "^0.1.6",
    "resolve.exports": "^2.0.3"
  },
  "peerDependencies": {
    "@mutantcat/cordis-plugin-group": "workspace:^",
    "@mutantcat/cordis-plugin-include": "workspace:^",
    "@mutantcat/cordis-plugin-loader": "workspace:^",
    "@mutantcat/dsh-launch-environment": "workspace:^",
    "@mutantcat/dsh-home-paths": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  },
  "devDependencies": {
    "@mutantcat/cordis-plugin-group": "workspace:^",
    "@mutantcat/cordis-plugin-include": "workspace:^",
    "@mutantcat/cordis-plugin-loader": "workspace:^",
    "@mutantcat/cordis-plugin-timer": "workspace:^",
    "@mutantcat/dsh-launch-environment": "workspace:^",
    "@mutantcat/dsh-home-paths": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@mutantcat/cordis": "workspace:^"
  }
}
