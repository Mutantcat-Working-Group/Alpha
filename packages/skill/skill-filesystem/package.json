    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/dsh-fs": "workspace:^",
    "@mutantcat/dsh-home-paths": "workspace:^",
    "@mutantcat/dsh-skill": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "@mutantcat/schemastery": "workspace:^",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@mutantcat/dsh-fs": "workspace:^",
    "@mutantcat/dsh-home-paths": "workspace:^",
    "@mutantcat/dsh-skill": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  }
