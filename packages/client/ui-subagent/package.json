{
  "name": "@mutantcat/dsh-client-ui-subagent",
  "description": "Subagent conversation catalog, continuation routing UI, and '@' reference source",
  "version": "1.0.20260923",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@mutantcat/dsh-api-session-controller",
        "@mutantcat/dsh-client-locale",
        "@mutantcat/dsh-client-resources",
        "@mutantcat/dsh-client-ui-chat",
        "@mutantcat/dsh-client-ui-conversation",
        "@mutantcat/dsh-client-ui-primitives",
        "@mutantcat/dsh-client-ui-sidebar-right",
        "@mutantcat/dsh-client-ui-input-trigger",
        "@mutantcat/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:^"
  },
  "devDependencies": {
    "@mutantcat/dsh-client-locale": "workspace:^",
    "@mutantcat/dsh-client-resources": "workspace:^",
    "@mutantcat/dsh-client-test-runtime": "workspace:^",
    "@mutantcat/dsh-client-ui-chat": "workspace:^",
    "@mutantcat/dsh-client-ui-conversation": "workspace:^",
    "@mutantcat/dsh-client-ui-input-trigger": "workspace:^",
    "@mutantcat/dsh-client-ui-primitives": "workspace:^",
    "@mutantcat/dsh-client-ui-slots": "workspace:^",
    "@mutantcat/dsh-subagent": "workspace:^",
    "@mutantcat/dsh-token-meter": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@mutantcat/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mutantcat/dsh-api-session-controller": "workspace:^",
    "@mutantcat/dsh-client-connection": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-client-ui-renderer": "workspace:^",
    "@mutantcat/dsh-client-ui-sidebar-right": "workspace:^",
    "@mutantcat/dsh-client-ui-session": "workspace:^",
    "@mutantcat/dsh-client-ui-workspace": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
