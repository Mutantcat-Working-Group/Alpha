{
  "name": "@mutantcat/dsh-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "1.0.20260925",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-subagent": "workspace:^",
    "@mutantcat/dsh-subprocess": "workspace:^",
    "@mutantcat/dsh-timeout": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@mutantcat/dsh-brand": "workspace:^",
    "@mutantcat/schemastery": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mutantcat/cordis": "workspace:^",
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-app-boot": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-loader-smoke": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-session-checkpoint-policy": "workspace:^",
    "@mutantcat/dsh-session-persistence-jsonl": "workspace:^",
    "@mutantcat/dsh-session-projection": "workspace:^",
    "@mutantcat/dsh-subagent": "workspace:^",
    "@mutantcat/dsh-subagent-codex": "workspace:^",
    "@mutantcat/dsh-subprocess": "workspace:^",
    "@mutantcat/dsh-subprocess-local": "workspace:^",
    "@mutantcat/dsh-timeout": "workspace:^",
    "@mutantcat/dsh-tool-jobs": "workspace:^",
    "@mutantcat/dsh-tool-subagent": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^"
  }
}
