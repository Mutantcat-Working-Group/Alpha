    "@mutantcat/dsh-subprocess-local": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@mutantcat/dsh-tool-bash": "workspace:^",
    "@mutantcat/dsh-tool-fs": "workspace:^",
