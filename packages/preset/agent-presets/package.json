{
  "name": "@mutantcat/dsh-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the DeepSeek Harness",
  "version": "1.0.20260923",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis-plugin-include": "workspace:^",
    "@mutantcat/cordis-plugin-loader": "workspace:^",
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-atomic-write": "workspace:^",
    "@mutantcat/dsh-invariants": "workspace:^",
    "@mutantcat/dsh-home-paths": "workspace:^",
    "@mutantcat/dsh-scope": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-session-projection": "workspace:^",
    "@mutantcat/dsh-settings": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^",
    "@mutantcat/dsh-typert-protocol": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@mutantcat/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mutantcat/dsh-app-boot": "workspace:^",
    "@mutantcat/cordis-plugin-group": "workspace:^",
    "@mutantcat/cordis-plugin-include": "workspace:^",
    "@mutantcat/cordis-plugin-loader": "workspace:^",
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-agent-loop": "workspace:^",
    "@mutantcat/dsh-atomic-write": "workspace:^",
    "@mutantcat/dsh-invariants": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-home-paths": "workspace:^",
    "@mutantcat/dsh-scope": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-session-projection": "workspace:^",
    "@mutantcat/dsh-settings": "workspace:^",
    "@mutantcat/dsh-settings-file": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^",
    "@mutantcat/dsh-typert-protocol": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  }
}
