{
  "name": "@mutantcat/dsh-agent-loop",
  "description": "The concrete agent loop plugin for the DeepSeek Harness",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent-loop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:~",
    "@mutantcat/dsh-agent": "workspace:*",
    "@mutantcat/dsh-invariants": "workspace:*",
    "@mutantcat/dsh-llm": "workspace:*",
    "@mutantcat/dsh-scope": "workspace:*",
    "@mutantcat/dsh-session": "workspace:*",
    "@mutantcat/dsh-session-persistence": "workspace:*",
    "@mutantcat/dsh-session-projection": "workspace:*",
    "@mutantcat/dsh-system-prompt": "workspace:*",
    "@mutantcat/dsh-tools": "workspace:*"
  },
  "dependencies": {
    "@mutantcat/dsh-brand": "workspace:*",
    "@mutantcat/dsh-util-values": "workspace:*",
    "@mutantcat/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mutantcat/dsh-llm-deepseek-api-key": "workspace:*",
    "@mutantcat/cordis": "workspace:~",
    "@mutantcat/dsh-llm-pi-ai": "workspace:*",
    "@mutantcat/dsh-agent": "workspace:*",
    "@mutantcat/dsh-invariants": "workspace:*",
    "@mutantcat/dsh-llm": "workspace:*",
    "@mutantcat/dsh-scope": "workspace:*",
    "@mutantcat/dsh-session": "workspace:*",
    "@mutantcat/dsh-session-persistence": "workspace:*",
    "@mutantcat/dsh-session-persistence-jsonl": "workspace:*",
    "@mutantcat/dsh-session-projection": "workspace:*",
    "@mutantcat/dsh-system-prompt": "workspace:*",
    "@mutantcat/dsh-tools": "workspace:*"
  }
}
