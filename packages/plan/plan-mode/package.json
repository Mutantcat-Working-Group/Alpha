{
  "name": "@mutantcat/dsh-plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "1.0.20260922",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/plan/plan-mode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-commands": "workspace:^",
    "@mutantcat/dsh-invariants": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-session-projection": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^",
    "@mutantcat/dsh-user-questions": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@mutantcat/dsh-commands": {
      "optional": true
    }
  },
  "dependencies": {
    "@mutantcat/dsh-brand": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-agent-loop": "workspace:^",
    "@mutantcat/dsh-ptc-runtime": "workspace:^",
    "@mutantcat/dsh-commands": "workspace:^",
    "@mutantcat/dsh-invariants": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-session-projection": "workspace:^",
    "@mutantcat/dsh-system-prompt": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^",
    "@mutantcat/dsh-user-questions": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  }
