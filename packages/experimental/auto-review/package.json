    "@mutantcat/dsh-fs-sandbox": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-llm-deepseek": "workspace:^",
    "@mutantcat/dsh-permission-presets": "workspace:^",
    "@mutantcat/dsh-ptc-runtime-node": "workspace:^",
    "@mutantcat/dsh-sandbox": "workspace:^",
    "@mutantcat/dsh-sandbox-policy": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-session-projection": "workspace:^",
    "@mutantcat/dsh-shell": "workspace:^",
