{
  "name": "@mutantcat/dsh-client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "1.0.20260924",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@mutantcat/dsh-api-session-controller",
        "@mutantcat/dsh-client-locale",
        "@mutantcat/dsh-client-ui-conversation",
        "@mutantcat/dsh-client-ui-renderer",
        "@mutantcat/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:^"
  },
  "devDependencies": {
    "@mutantcat/dsh-agent": "workspace:^",
    "@mutantcat/dsh-client-locale": "workspace:^",
    "@mutantcat/dsh-client-test-runtime": "workspace:^",
    "@mutantcat/dsh-client-ui-primitives": "workspace:^",
    "@mutantcat/dsh-client-ui-conversation": "workspace:^",
    "@mutantcat/dsh-client-ui-slots": "workspace:^",
    "@mutantcat/dsh-compaction": "workspace:^",
    "@mutantcat/dsh-tools": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@mutantcat/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@mutantcat/dsh-client-store": "workspace:^",
    "@mutantcat/dsh-client-ui-chat": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@mutantcat/dsh-api-session-controller": "workspace:^",
    "@mutantcat/dsh-client-ui-renderer": "workspace:^",
    "@mutantcat/dsh-client-ui-session": "workspace:^",
    "@mutantcat/dsh-llm": "workspace:^",
    "@mutantcat/dsh-attachment": "workspace:^",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
