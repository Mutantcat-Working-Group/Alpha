{
  "name": "@mutantcat/dsh-web-frontend",
  "description": "Web application entry: vite build over the @mutantcat/dsh-client-web shell library; dist/ served by apps/cli's dsh web",
  "version": "1.0.20260922",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @mutantcat/dsh-experimental-webworker-runtime exec tsdown && pnpm --filter @mutantcat/dsh-experimental-webworker-packer exec tsdown && vite build && dsh-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  },
  "license": "MIT",
  "devDependencies": {
    "@mutantcat/cordis-plugin-group": "workspace:^",
    "@mutantcat/dsh-client-modules": "workspace:^",
    "@mutantcat/dsh-client-store": "workspace:^",
    "@mutantcat/dsh-client-test-runtime": "workspace:^",
    "@mutantcat/dsh-client-ui-dockkit": "workspace:^",
    "@mutantcat/dsh-client-ui-primitives": "workspace:^",
    "@mutantcat/dsh-client-ui-slots": "workspace:^",
    "@mutantcat/dsh-client-web": "workspace:^",
    "@mutantcat/dsh-cmdline": "workspace:^",
    "@mutantcat/dsh-pwsh-local": "workspace:^",
    "@mutantcat/dsh-experimental-webworker-packer": "workspace:^",
    "@mutantcat/dsh-experimental-webworker-runtime": "workspace:^",
    "@mutantcat/dsh-remote-mock": "workspace:^",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "ws": "8.21.0",
    "@mutantcat/dsh-launch-environment": "workspace:^",
    "@mutantcat/dsh-workspace-changes": "workspace:^",
    "@mutantcat/dsh-subprocess-local": "workspace:^",
    "@mutantcat/dsh-experimental-auto-review": "workspace:^"
  }
}
