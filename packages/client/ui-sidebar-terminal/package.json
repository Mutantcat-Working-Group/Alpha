{
  "name": "@mutantcat/dsh-client-ui-sidebar-terminal",
  "description": "Interactive shell tabs for the right Sidebar",
  "version": "1.0.20260923",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-sidebar-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@mutantcat/dsh-api-terminal-controller",
        "@mutantcat/dsh-client-ui-sidebar-right",
        "@mutantcat/dsh-api-remotes",
        "@mutantcat/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:^"
  },
  "devDependencies": {
    "@mutantcat/cordis": "workspace:^",
    "@mutantcat/dsh-api-remotes": "workspace:^",
    "@mutantcat/dsh-client-locale": "workspace:^",
    "@mutantcat/dsh-client-store": "workspace:^",
    "@mutantcat/dsh-client-test-runtime": "workspace:^",
    "@mutantcat/dsh-client-ui-dockkit": "workspace:^",
    "@mutantcat/dsh-client-ui-primitives": "workspace:^",
    "@mutantcat/dsh-client-ui-renderer": "workspace:^",
    "@mutantcat/dsh-client-ui-session": "workspace:^",
    "@mutantcat/dsh-client-ui-sidebar-right": "workspace:^",
    "@mutantcat/dsh-client-ui-slots": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0",
    "@mutantcat/dsh-api-terminal-controller": "workspace:^",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@mutantcat/dsh-client-ui-layout": "workspace:^",
    "@mutantcat/dsh-client-ui-conversation": "workspace:^",
    "@mutantcat/dsh-client-ui-theme": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ]
}
