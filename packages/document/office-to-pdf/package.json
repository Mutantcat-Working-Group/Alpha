{
  "name": "@mutantcat/dsh-office-to-pdf",
  "description": "Shared Office-to-PDF conversion with bounded queues and caching",
  "version": "1.0.20260926",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/document/office-to-pdf"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:^"
  },
  "devDependencies": {
    "@mutantcat/cordis": "workspace:^",
    "@mutantcat/cordis-plugin-loader": "workspace:^",
    "@mutantcat/cordis-plugin-include": "workspace:^",
    "@mutantcat/dsh-api-workspace-files": "workspace:^",
    "@mutantcat/dsh-fs": "workspace:^",
    "@mutantcat/dsh-session": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "0.0.1",
    "@mutantcat/schemastery": "workspace:^",
    "@mutantcat/dsh-brand": "workspace:^",
    "@mutantcat/dsh-typert-protocol": "workspace:^",
    "zod": "^4.4.3"
  }
}
