{
  "name": "@mutantcat/dsh-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "1.0.20260926",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/cordis": "workspace:~",
    "@mutantcat/dsh-agent": "workspace:*",
    "@mutantcat/dsh-invariants": "workspace:*",
    "@mutantcat/dsh-jobs": "workspace:*",
    "@mutantcat/dsh-llm": "workspace:*",
    "@mutantcat/dsh-session": "workspace:*",
    "@mutantcat/dsh-system-prompt": "workspace:*",
    "@mutantcat/dsh-tools": "workspace:*",
    "@mutantcat/dsh-workflow": "workspace:*"
  },
  "dependencies": {
    "@mutantcat/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@mutantcat/cordis": "workspace:~",
    "@mutantcat/dsh-agent": "workspace:*",
    "@mutantcat/dsh-agent-loop-testkit": "workspace:*",
    "@mutantcat/dsh-invariants": "workspace:*",
    "@mutantcat/dsh-jobs": "workspace:*",
    "@mutantcat/dsh-jobs-local": "workspace:*",
    "@mutantcat/dsh-llm": "workspace:*",
    "@mutantcat/dsh-session": "workspace:*",
    "@mutantcat/dsh-session-projection": "workspace:*",
    "@mutantcat/dsh-subagent": "workspace:*",
    "@mutantcat/dsh-system-prompt": "workspace:*",
    "@mutantcat/dsh-tool-jobs": "workspace:*",
    "@mutantcat/dsh-tools": "workspace:*",
    "@mutantcat/dsh-workflow": "workspace:*",
    "@mutantcat/dsh-workflow-ptc": "workspace:*"
  }
}
