{
  "name": "@mutantcat/dsh-subprocess-local",
  "description": "Local-subprocess implementation of the Alpha subprocess seam",
  "version": "1.0.20261012",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mutantcat-Working-Group/Alpha.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./lib/types/output.d.ts",
      "default": "./lib/output.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/runner-*.js",
    "lib/output.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@mutantcat/dsh-subprocess": "workspace:^",
    "@mutantcat/dsh-timeout": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  },
  "dependencies": {
    "@mutantcat/dsh-lazy-require": "workspace:^",
    "@mutantcat/dsh-win32-process": "workspace:^",
    "koffi": "3.2.1",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@mutantcat/dsh-loader-smoke": "workspace:^",
    "@mutantcat/dsh-subprocess": "workspace:^",
    "@mutantcat/dsh-timeout": "workspace:^",
    "@mutantcat/cordis": "workspace:^"
  }
}
